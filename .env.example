# Local-only PostgreSQL database. Create this database before migrating.
DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/mtjr2_demo?schema=public"

# Server-side canonical application URL (not exposed to browser bundles).
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Public account creation stays disabled until approved policy versions are published.
PUBLIC_REGISTRATION_ENABLED="false"

# Generate a unique local secret; never commit a real secret.
AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

# Optional but required to enroll MFA. Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=""

# Optional demo catalog; seed.cjs requires a dedicated demo/test database and explicit opt-in.
DEMO_DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/mtjr2_demo?schema=public"
SEED_DEMO_CATALOG="true"
ALLOW_DEMO_CATALOG_SEED="true"

# Optional transactional email (leave blank for local browsing without email delivery).
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Optional Google OpenID Connect (redirect URI: http://localhost:3000/api/auth/google/callback).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Leave TRUSTED_PROXY_IP_HEADER unset in local development; identity throttles use a loopback bucket.
# Production identity endpoints stay closed until a trusted edge header is configured.


# Support SLA worker. Configure the same secret in GitHub Actions repository secrets.
CRON_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

# Cloudflare R2 (S3-compatible). Keep credentials server-side only.
# Bucket CORS must allow PUT with Content-Type and If-None-Match headers from APP_URL.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
ATTACHMENT_SCANNER_URL=""
ATTACHMENT_SCANNER_TOKEN=""

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/mtjr2?schema=public"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Public account creation is disabled until approved Terms of Service and Privacy Notice are published.
# Do not enable until the UI presents the exact approved policy versions before consent.
PUBLIC_REGISTRATION_ENABLED="false"

# Authentication secrets must be generated locally; never commit real values.
AUTH_SECRET="replace-with-a-32-character-or-longer-random-secret"

# Trusted deployment proxy IP header. Set ONLY when the edge proxy overwrites
# the selected header and direct access to the application origin is blocked.
# Supported values: cf-connecting-ip (Cloudflare), x-vercel-forwarded-for (Vercel).
# Leave unset in local development; IP-dependent public auth routes fail closed.
# TRUSTED_PROXY_IP_HEADER="cf-connecting-ip"

# Resend transactional email (use a verified sending domain/address)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="no-reply@your-verified-domain.com"

# Optional Google OpenID Connect sign-in (redirect URI: /api/auth/google/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

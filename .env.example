# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/mtjr2?schema=public"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Authentication secrets must be generated locally; never commit real values.
AUTH_SECRET="replace-with-a-32-character-or-longer-random-secret"

# Resend transactional email (use a verified sending domain/address)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="no-reply@your-verified-domain.com"

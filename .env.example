# Local application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mtjr2_demo"

# Required application secret: replace with a unique random value of 32+ characters.
AUTH_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"

# Set a stable, unique 32+ character key before enabling MFA in production.
# If unset, MFA secret encryption derives its key from AUTH_SECRET.
MFA_ENCRYPTION_KEY=""

# Optional feature and service configuration
PUBLIC_REGISTRATION_ENABLED="false"
CRON_SECRET=""
TRUSTED_PROXY_IP_HEADER=""

# Optional Google OpenID Connect credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudflare Turnstile registration bot check; configure both values.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Server-side canonical application URL (not exposed to browser bundles).
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Optional demo catalog; seeding requires explicit opt-in and a dedicated demo/test database.
DEMO_DATABASE_URL="******localhost:5432/mtjr2_demo?schema=public"
SEED_DEMO_CATALOG="false"
ALLOW_DEMO_CATALOG_SEED="false"

# Optional transactional email configuration
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
CONTACT_EMAIL=""

# Leave TRUSTED_PROXY_IP_HEADER unset in local development; identity throttles use a loopback bucket.
# Production identity endpoints stay closed until a trusted edge header is configured.

# Support SLA worker. Configure the same secret in GitHub Actions repository secrets.

# Cloudflare R2 (S3-compatible). Keep credentials server-side only.
# Bucket CORS must allow PUT with Content-Type and If-None-Match headers from APP_URL.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
ATTACHMENT_SCANNER_URL=""
ATTACHMENT_SCANNER_TOKEN=""

# Matjar AI assistant (Groq free tier). Keep the API key server-side only.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
AI_ASSISTANT_ENABLED="false"

# Product image uploads (server-side only; never use NEXT_PUBLIC_ for provider secrets).
# Upload tries Imgur first, then ImageKit as a fallback.
# Add Imgur Client IDs in the exact rotation order, separated by commas.
# Each ID is used for up to 50 uploads before moving to the next; the sequence resets hourly.
IMGUR_CLIENT_IDS=""
# Optional single-ID compatibility fallback:
IMGUR_CLIENT_ID=""
# Optional account OAuth token required to delete Imgur images after product-image removal.
IMGUR_ACCESS_TOKEN=""
IMAGEKIT_PRIVATE_KEY=""

# Optional Cloudinary unsigned upload fallback. The preset must have unsigned uploads enabled.
# Prefer server-only names; legacy NEXT_PUBLIC_* values are read only for compatibility.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET=""
# Required only for server-side Cloudinary asset deletion; never expose these values to the browser.
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Leaflet map tiles. OSM's public tile server is for low-volume development/testing only.
# Configure a contracted commercial tile provider and its required public browser key for production.
# Keep the attribution string exactly as required by that provider.
NEXT_PUBLIC_MAP_TILE_URL=""
NEXT_PUBLIC_MAP_ATTRIBUTION=""

# Optional Stripe Checkout. Both values are required to expose Stripe as a payment method.
# Configure Stripe webhook endpoint: https://YOUR_APP_URL/api/webhooks/payments/stripe
# Subscribe to checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, and checkout.session.expired.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional PayPal Checkout. Keep the client secret and webhook ID server-side only.
# Configure a PayPal webhook endpoint at https://YOUR_APP_URL/api/webhooks/payments/paypal
# Subscribe to PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.PENDING and PAYMENT.CAPTURE.DENIED.
# Use sandbox first; switch PAYPAL_MODE to live only after owner-approved live credentials are configured.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_MODE="sandbox"

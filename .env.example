# Local application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mtjr2_demo"

# Required application secret: replace with a unique random value of 32+ characters.
AUTH_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"

# Optional feature and service configuration
PUBLIC_REGISTRATION_ENABLED="false"
CRON_SECRET=""
TRUSTED_PROXY_IP_HEADER=""

# Optional Google OpenID Connect credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional Resend email configuration
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

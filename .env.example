# Local application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mtjr2_demo"

# Required application secret: replace with a unique random value of 32+ characters.
AUTH_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"

# Set a stable, unique 32+ character key before enabling MFA in production.
# If unset, MFA secret encryption derives its key from AUTH_SECRET.
MFA_ENCRYPTION_KEY=""

# Optional feature and service configuration
PUBLIC_REGISTRATION_ENABLED="false"
CRON_SECRET=""
TRUSTED_PROXY_IP_HEADER=""

# Optional Google OpenID Connect credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudflare Turnstile registration bot check; configure both values.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Server-side canonical application URL (not exposed to browser bundles).
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Optional demo catalog; seeding requires explicit opt-in and a dedicated demo/test database.
DEMO_DATABASE_URL="******localhost:5432/mtjr2_demo?schema=public"
SEED_DEMO_CATALOG="false"
ALLOW_DEMO_CATALOG_SEED="false"

# Optional transactional email configuration
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Leave TRUSTED_PROXY_IP_HEADER unset in local development; identity throttles use a loopback bucket.
# Production identity endpoints stay closed until a trusted edge header is configured.

# Support SLA worker. Configure the same secret in GitHub Actions repository secrets.

# Cloudflare R2 (S3-compatible). Keep credentials server-side only.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
ATTACHMENT_SCANNER_URL=""
ATTACHMENT_SCANNER_TOKEN=""

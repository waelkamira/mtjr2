# Local-only PostgreSQL database. Create this database before migrating.
DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/mtjr2_demo?schema=public"

# Server-side canonical application URL (not exposed to browser bundles).
APP_URL="http://localhost:3000"
NODE_ENV="development"


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  MARKETING_EMAIL
  COOKIES
}

enum AuditActorType {
  USER
  SYSTEM
  API
}

model User {
  id                String                 @id @default(cuid())
  email             String                 @unique
  emailNormalized   String                 @unique
  passwordHash      String?
  displayName       String?
  status            UserStatus             @default(PENDING)
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  sessions          UserSession[]
  oauthAccounts     OAuthAccount[]
  roleAssignments   UserRoleAssignment[]
  passwordResets    PasswordResetToken[]
  verificationTokens VerificationToken[]
  consents          UserConsent[]
  loginAttempts     LoginAttempt[]
  auditEvents       AuditLog[]             @relation("AuditActor")
  sellerProfile     Seller?
  storeMemberships  SellerStaff[]          @relation("SellerStaffUser")
  sentStoreInvitations SellerStaff[]        @relation("SellerStaffInviter")
  carts                 Cart[]
  checkoutQuotes        CheckoutQuote[]
  addresses             UserAddress[]
  orders                Order[]
  returnRequests        ReturnRequest[] @relation("ReturnRequestCustomer")
  reviewedReturnRequests ReturnRequest[] @relation("ReturnRequestReviewer")
  notifications         Notification[]
  notificationPreferences NotificationPreference[]
  productReviews        ProductReview[]
  productQuestions      ProductQuestion[]
  productAnswers        ProductAnswer[]
  storeReviews          StoreReview[]
  favorites             Favorite[]
  supportTickets        SupportTicket[] @relation("SupportTicketCustomer")
  assignedSupportTickets SupportTicket[] @relation("SupportTicketAssignee")
  supportMessages       SupportMessage[]
  storeConversations    StoreConversation[] @relation("ConversationCustomer")
  sentStoreMessages    StoreMessage[] @relation("StoreMessageSender")

  @@index([status, createdAt])
  @@index([createdAt])
}

model Role {
  id          String               @id @default(cuid())
  key         String               @unique
  name        String
  description String?
  isSystem    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  permissions RolePermission[]
  assignments UserRoleAssignment[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRoleAssignment {
  id          String    @id @default(cuid())
  userId      String
  roleId      String
  // GLOBAL is the reserved unscoped assignment; scoped grants must provide both values.
  scopeType   String    @default("GLOBAL")
  scopeId     String    @default("GLOBAL")
  assignedAt  DateTime  @default(now())
  expiresAt   DateTime?
  assignedBy  String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([userId, expiresAt])
  @@index([roleId, scopeType, scopeId])
}

model UserSession {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model VerificationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  purpose    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
}

model UserConsent {
  id          String      @id @default(cuid())
  userId      String
  type        ConsentType
  version     String
  granted     Boolean
  capturedAt  DateTime    @default(now())
  source      String?
  ipAddress   String?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, capturedAt])
}

model LoginAttempt {
  id             String   @id @default(cuid())
  userId         String?
  identifierHash String
  ipHash         String?
  succeeded      Boolean
  attemptedAt    DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifierHash, attemptedAt])
  @@index([ipHash, attemptedAt])
  @@index([userId, attemptedAt])
}

model LoginRateLimitBucket {
  keyHash         String   @id
  windowStartedAt DateTime
  attemptCount    Int      @default(0)
  blockedUntil    DateTime?
  updatedAt       DateTime @updatedAt

  @@index([blockedUntil])
}

model AuditLog {
  id          String          @id @default(cuid())
  actorType   AuditActorType
  actorId     String?
  action      String
  resource    String
  resourceId  String?
  scopeType   String?
  scopeId     String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  occurredAt  DateTime        @default(now())
  actor       User?           @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, occurredAt])
  @@index([resource, resourceId, occurredAt])
  @@index([scopeType, scopeId, occurredAt])
  @@index([occurredAt])
}


enum MarketStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum StoreStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
}

enum SellerStaffStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum CatalogEntityStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductMediaType {
  IMAGE
  VIDEO
}

enum AttributeValueType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
}

enum InventoryMovementType {
  RECEIPT
  SALE
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
}

enum InventoryReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum StockTransferStatus {
  DRAFT
  SHIPPED
  RECEIVED
  CANCELLED
}

enum CartStatus {
  ACTIVE
  MERGED
  CHECKED_OUT
  ABANDONED
}

enum CheckoutQuoteStatus {
  ACTIVE
  EXPIRED
  RELEASED
  CONVERTED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  INITIATING
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

enum VendorOrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
}

enum ProductQuestionStatus {
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
}

enum ProductAnswerStatus {
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
}

model Country {
  id               String   @id @default(cuid())
  iso2             String   @unique @db.Char(2)
  iso3             String?  @unique @db.Char(3)
  name             String
  nativeName       String?
  phoneCallingCode String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  markets          Market[]
  userAddresses    UserAddress[]

  @@index([isActive, name])
}

model Currency {
  code          String           @id @db.Char(3)
  name          String
  symbol        String?
  minorUnit     Int              @default(2)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  defaultMarkets Market[]        @relation("MarketDefaultCurrency")
  marketLinks   MarketCurrency[]
  productPrices ProductPrice[]
  carts         Cart[]
  checkoutQuotes CheckoutQuote[]
  orders Order[]
  payments Payment[]
  shippingRates StoreShippingRate[]

  @@index([isActive, name])
}

model Market {
  id                  String          @id @default(cuid())
  code                String          @unique @db.VarChar(32)
  name                String
  countryId           String
  defaultCurrencyCode String          @db.Char(3)
  status              MarketStatus    @default(DRAFT)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  country             Country         @relation(fields: [countryId], references: [id], onDelete: Restrict)
  defaultCurrency     Currency        @relation("MarketDefaultCurrency", fields: [defaultCurrencyCode], references: [code], onDelete: Restrict)
  currencies          MarketCurrency[]
  storeLinks          StoreMarket[]
  productPrices       ProductPrice[]
  carts               Cart[]
  checkoutQuotes      CheckoutQuote[]
  orders              Order[]
  shippingRates       StoreShippingRate[]
  taxRates            MarketTaxRate[]

  @@index([countryId, status])
  @@index([defaultCurrencyCode])
}

model MarketCurrency {
  marketId    String   @db.Text
  currencyCode String  @db.Char(3)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  market      Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  currency    Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  @@id([marketId, currencyCode])
  @@index([currencyCode, isEnabled])
}


model Seller {
  id          String       @id @default(cuid())
  ownerId     String       @unique
  status      SellerStatus @default(PENDING)
  legalName   String?
  displayName String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  stores      Store[]

  @@index([status, createdAt])
}

model Store {
  id        String      @id @default(cuid())
  sellerId  String
  slug      String      @unique @db.VarChar(160)
  name      String
  status    StoreStatus @default(DRAFT)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  seller    Seller      @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  markets   StoreMarket[]
  staff     SellerStaff[]
  products  Product[]
  reviews   StoreReview[]
  warehouses Warehouse[]
  stockTransfers StockTransfer[]
  shippingRates StoreShippingRate[]
  checkoutShippingSelections CheckoutShippingSelection[]
  checkoutQuoteLines CheckoutQuoteLine[]
  vendorOrders VendorOrder[]
  conversations StoreConversation[]

  @@index([sellerId, status])
  @@index([status, createdAt])
}

model StoreMarket {
  storeId   String
  marketId  String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@id([storeId, marketId])
  @@index([marketId, isEnabled])
}

model SellerStaff {
  id          String            @id @default(cuid())
  storeId     String
  userId      String
  invitedById String?
  status      SellerStaffStatus @default(INVITED)
  invitedAt   DateTime          @default(now())
  acceptedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user        User              @relation("SellerStaffUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy   User?             @relation("SellerStaffInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([storeId, userId])
  @@index([userId, status])
  @@index([storeId, status])
}


model Category {
  id          String              @id @default(cuid())
  parentId    String?
  slug        String              @unique @db.VarChar(180)
  name        String
  description String?
  imageUrl    String?
  status      CatalogEntityStatus @default(DRAFT)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  parent      Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]          @relation("CategoryTree")
  translations CategoryTranslation[]
  productLinks ProductCategory[]

  @@index([parentId, status, sortOrder])
  @@index([status, sortOrder])
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  locale      String   @db.VarChar(16)
  name        String
  description String?
  seoTitle    String?
  seoDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale, name])
}

model Brand {
  id          String              @id @default(cuid())
  slug        String              @unique @db.VarChar(180)
  name        String
  description String?
  logoUrl     String?
  websiteUrl  String?
  status      CatalogEntityStatus @default(DRAFT)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  translations BrandTranslation[]
  products     Product[]

  @@index([status, name])
}

model BrandTranslation {
  id          String   @id @default(cuid())
  brandId     String
  locale      String   @db.VarChar(16)
  name        String
  description String?
  seoTitle    String?
  seoDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, locale])
  @@index([locale, name])
}


model Product {
  id             String                @id @default(cuid())
  storeId        String
  brandId        String?
  slug           String                @db.VarChar(180)
  name           String
  description    String?
  status         CatalogEntityStatus   @default(DRAFT)
  approvalStatus ProductApprovalStatus @default(PENDING)
  rejectionReason String?
  approvedAt     DateTime?
  publishedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  store          Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  brand          Brand?                @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categories     ProductCategory[]
  translations   ProductTranslation[]
  media          ProductMedia[]
  variants       ProductVariant[]
  identifiers    ProductIdentifier[]
  attributes     ProductAttribute[]
  orderItems     OrderItem[]
  reviews        ProductReview[]
  questions      ProductQuestion[]
  favorites      Favorite[]

  @@unique([storeId, slug])
  @@index([storeId, status, approvalStatus, createdAt])
  @@index([brandId, status])
}

model ProductCategory {
  productId  String
  categoryId String
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId, productId])
}

model ProductTranslation {
  id          String   @id @default(cuid())
  productId   String
  locale      String   @db.VarChar(16)
  name        String
  description String?
  seoTitle    String?
  seoDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale, name])
}

model ProductMedia {
  id         String          @id @default(cuid())
  productId  String
  type       ProductMediaType @default(IMAGE)
  url        String
  storageKey String?
  mimeType   String?
  altText    String?
  sortOrder  Int             @default(0)
  isPrimary  Boolean         @default(false)
  width      Int?
  height     Int?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  sku         String   @unique @db.VarChar(100)
  barcode     String?  @unique @db.VarChar(100)
  name        String?
  optionValues Json?
  weightGrams Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices      ProductPrice[]
  attributes  VariantAttribute[]
  inventories Inventory[]
  transferItems StockTransferItem[]
  orderItems OrderItem[]
  cartItems     CartItem[]
  checkoutQuoteLines CheckoutQuoteLine[]

  @@index([productId, isActive])
}

model ProductIdentifier {
  id             String   @id @default(cuid())
  productId      String
  identifierType String   @db.VarChar(32)
  value          String   @db.VarChar(128)
  createdAt      DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([identifierType, value])
  @@index([productId])
}

model ProductPrice {
  id               String         @id @default(cuid())
  variantId        String
  marketId         String
  currencyCode     String         @db.Char(3)
  amountMinor      BigInt
  compareAtMinor   BigInt?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  market           Market         @relation(fields: [marketId], references: [id], onDelete: Restrict)
  currency         Currency       @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  @@unique([variantId, marketId, currencyCode])
  @@index([marketId, currencyCode, amountMinor])
}


model AttributeDefinition {
  id               String            @id @default(cuid())
  key              String            @unique @db.VarChar(100)
  valueType        AttributeValueType
  isVariantLevel   Boolean           @default(false)
  isFilterable     Boolean           @default(false)
  isRequired       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  translations     AttributeTranslation[]
  productValues    ProductAttribute[]
  variantValues    VariantAttribute[]

  @@index([isFilterable, valueType])
}

model AttributeTranslation {
  id                   String             @id @default(cuid())
  attributeDefinitionId String
  locale               String             @db.VarChar(16)
  name                 String
  description          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  attribute            AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([attributeDefinitionId, locale])
  @@index([locale, name])
}

model ProductAttribute {
  id                   String             @id @default(cuid())
  productId            String
  attributeDefinitionId String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  product              Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute            AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)
  values               ProductAttributeValue[]

  @@unique([productId, attributeDefinitionId])
  @@index([attributeDefinitionId])
}

model ProductAttributeValue {
  id                 String          @id @default(cuid())
  productAttributeId String
  value              Json
  sortOrder          Int             @default(0)
  createdAt          DateTime        @default(now())
  productAttribute   ProductAttribute @relation(fields: [productAttributeId], references: [id], onDelete: Cascade)

  @@index([productAttributeId, sortOrder])
}

model VariantAttribute {
  id                   String             @id @default(cuid())
  variantId            String
  attributeDefinitionId String
  value                Json
  createdAt            DateTime           @default(now())
  variant              ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute            AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)

  @@unique([variantId, attributeDefinitionId])
  @@index([attributeDefinitionId])
}


model SearchSynonym {
  id        String   @id @default(cuid())
  locale    String   @db.VarChar(16)
  term      String   @db.VarChar(160)
  synonym   String   @db.VarChar(160)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, term, synonym])
  @@index([locale, term, isActive])
}


model Warehouse {
  id             String          @id @default(cuid())
  storeId        String
  code           String          @db.VarChar(40)
  name           String
  isActive       Boolean         @default(true)
  address        Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  inventories    Inventory[]
  outgoingTransfers StockTransfer[] @relation("StockTransferSource")
  incomingTransfers StockTransfer[] @relation("StockTransferDestination")

  @@unique([storeId, code])
  @@index([storeId, isActive, name])
}

model Inventory {
  id                String                 @id @default(cuid())
  warehouseId       String
  variantId         String
  quantityOnHand    Int                    @default(0)
  quantityReserved  Int                    @default(0)
  reorderPoint      Int                    @default(0)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  warehouse         Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant           ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  movements         InventoryMovement[]
  reservations      InventoryReservation[]

  @@unique([warehouseId, variantId])
  @@index([variantId, warehouseId])
  @@index([warehouseId, quantityOnHand, quantityReserved])
}

model InventoryMovement {
  id             String                @id @default(cuid())
  inventoryId    String
  type           InventoryMovementType
  quantityDelta  Int
  referenceType  String?               @db.VarChar(40)
  referenceId    String?               @db.VarChar(128)
  idempotencyKey String?               @unique @db.VarChar(160)
  note           String?               @db.VarChar(500)
  createdById    String?
  createdAt      DateTime              @default(now())
  inventory      Inventory             @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  @@index([inventoryId, createdAt])
  @@index([referenceType, referenceId])
}

model InventoryReservation {
  id             String                    @id @default(cuid())
  inventoryId    String
  quantity       Int
  status         InventoryReservationStatus @default(ACTIVE)
  referenceType  String                    @db.VarChar(40)
  referenceId    String                    @db.VarChar(128)
  idempotencyKey String                    @unique @db.VarChar(160)
  expiresAt      DateTime
  consumedAt     DateTime?
  releasedAt     DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  inventory      Inventory                 @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([inventoryId, status])
  @@index([referenceType, referenceId])
}

model StockTransfer {
  id                String             @id @default(cuid())
  storeId           String
  sourceWarehouseId String
  destinationWarehouseId String
  status            StockTransferStatus @default(DRAFT)
  reference         String?            @db.VarChar(100)
  idempotencyKey    String             @unique @db.VarChar(160)
  createdById       String?
  shippedAt         DateTime?
  receivedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  updatedAt     DateTime            @updatedAt
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer      User                @relation("ReturnRequestCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  reviewedBy    User?               @relation("ReturnRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  items         ReturnItem[]
  refund        Refund?

  @@index([customerId, requestedAt])
  @@index([orderId, status])
  @@index([status, requestedAt])
}

model ReturnItem {
  id              String        @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int
  status          ReturnItemStatus @default(REQUESTED)
  reviewNote      String?         @db.VarChar(1000)
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime      @default(now())
  reviewedBy      User?         @relation("ReturnItemReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  refundItem      RefundItem?

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
  @@index([status, reviewedAt])
}

model ProductReview {
  id          String         @id @default(cuid())
  productId   String
  userId      String
  orderItemId String         @unique

  incomingTransfers StockTransfer[] @relation("StockTransferDestination")

  @@unique([storeId, code])
  @@index([storeId, isActive, name])
}

model Inventory {
  id               String                 @id @default(cuid())
  warehouseId      String
  variantId        String
  quantityOnHand   Int                    @default(0)
  quantityQuarantined Int                  @default(0)
  quantityReserved Int                    @default(0)

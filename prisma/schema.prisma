  answer    ProductAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  editor    User     @relation(fields: [editorId], references: [id], onDelete: Restrict)

  @@index([answerId, createdAt])
  @@index([editorId, createdAt])
}

model ProductQuestionReport {
  id         String   @id @default(cuid())
  questionId String
  answerId   String?
  reporterId String
  reason     String   @db.VarChar(32)

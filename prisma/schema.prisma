  question   ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     ProductAnswer? @relation(fields: [answerId], references: [id], onDelete: SetNull)
  reporter   User @relation("ProductQuestionReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  moderator  User? @relation("ProductQuestionReportModerator", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([questionId, reporterId])

model SyriaLocality {
  id            String            @id
  governorateId String
  districtId    String?
  subdistrictId String?
  nameEn        String
  nameAr        String?
  kind          String
  latitude      Float?
  longitude     Float?
  sourceVersion String            @db.VarChar(20)
  sourceIds     String[]
  aliases       Json?

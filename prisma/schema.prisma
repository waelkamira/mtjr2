enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model SupportTicket {
  id             String                @id @default(cuid())
  ticketNumber   String                @unique @db.VarChar(24)
  customerId     String
  assignedToId   String?
  subject        String                @db.VarChar(180)
  category       String                @db.VarChar(32)
  status         SupportTicketStatus   @default(OPEN)
  priority       SupportTicketPriority @default(NORMAL)
  lastMessageAt  DateTime              @default(now())
  resolvedAt     DateTime?
  closedAt       DateTime?
  customerReadAt DateTime?
  agentReadAt    DateTime?
  firstResponseAt DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  customer       User                  @relation("SupportTicketCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  assignedTo     User?                 @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages       SupportMessage[]

  @@index([customerId, updatedAt])
  @@index([status, priority, lastMessageAt])
  @@index([assignedToId, status, lastMessageAt])
}

model SupportMessage {
  id          String        @id @default(cuid())
  ticketId    String
  senderId    String
  body        String        @db.VarChar(8000)
  isInternal  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender      User          @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([ticketId, isInternal, createdAt])
  @@index([senderId, createdAt])
}


model StoreConversation {
  id             String   @id @default(cuid())
  customerId     String
  storeId        String
  orderId        String?
  subject        String   @db.VarChar(180)
  lastMessageAt  DateTime @default(now())
  customerReadAt DateTime?
  storeReadAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  customer       User     @relation("ConversationCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages       StoreMessage[]

  @@index([customerId, updatedAt])
  @@index([storeId, lastMessageAt])
  @@index([orderId])
}

model StoreMessage {
  id             String           @id @default(cuid())
  conversationId String
  senderId       String
  body           String           @db.VarChar(8000)
  createdAt      DateTime         @default(now())
  conversation   StoreConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User             @relation("StoreMessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}


model Payment {
  id                  String        @id @default(cuid())
  orderId             String
  provider            String        @db.VarChar(64)
  status              PaymentStatus @default(INITIATING)
  amountMinor         BigInt
  currencyCode        String        @db.Char(3)
  idempotencyKey      String        @unique @db.VarChar(180)
  providerReference   String?       @db.VarChar(180)
  checkoutUrl         String?       @db.VarChar(2000)
  expiresAt           DateTime?
  failureCode         String?       @db.VarChar(120)
  failureMessage      String?       @db.VarChar(500)
  succeededAt         DateTime?
  lastProviderEventAt DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  order               Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  currency            Currency      @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  events              PaymentWebhookEvent[]

  @@unique([provider, providerReference])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model PaymentWebhookEvent {
  id              String    @id @default(cuid())
  provider        String    @db.VarChar(64)
  providerEventId String    @db.VarChar(200)
  eventType       String    @db.VarChar(120)
  paymentId       String?
  payloadHash     String    @db.Char(64)
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  processingError String?   @db.VarChar(500)
  payment         Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([paymentId, receivedAt])
  @@index([processedAt, receivedAt])
}
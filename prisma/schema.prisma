generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  MARKETING_EMAIL
  COOKIES
}

enum AuditActorType {
  USER
  SYSTEM
  API
}

model User {
  id                String                 @id @default(cuid())
  email             String                 @unique
  emailNormalized   String                 @unique
  passwordHash      String?
  displayName       String?
  status            UserStatus             @default(PENDING)
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  sessions          UserSession[]
  oauthAccounts     OAuthAccount[]
  roleAssignments   UserRoleAssignment[]
  passwordResets    PasswordResetToken[]
  verificationTokens VerificationToken[]
  consents          UserConsent[]
  loginAttempts     LoginAttempt[]
  auditEvents       AuditLog[]             @relation("AuditActor")
  sellerProfile     Seller?
  storeMemberships  SellerStaff[]          @relation("SellerStaffUser")
  sentStoreInvitations SellerStaff[]        @relation("SellerStaffInviter")

  @@index([status, createdAt])
  @@index([createdAt])
}

model Role {
  id          String               @id @default(cuid())
  key         String               @unique
  name        String
  description String?
  isSystem    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  permissions RolePermission[]
  assignments UserRoleAssignment[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRoleAssignment {
  id          String    @id @default(cuid())
  userId      String
  roleId      String
  // GLOBAL is the reserved unscoped assignment; scoped grants must provide both values.
  scopeType   String    @default("GLOBAL")
  scopeId     String    @default("GLOBAL")
  assignedAt  DateTime  @default(now())
  expiresAt   DateTime?
  assignedBy  String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([userId, expiresAt])
  @@index([roleId, scopeType, scopeId])
}

model UserSession {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model VerificationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  purpose    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
}

model UserConsent {
  id          String      @id @default(cuid())
  userId      String
  type        ConsentType
  version     String
  granted     Boolean
  capturedAt  DateTime    @default(now())
  source      String?
  ipAddress   String?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, capturedAt])
}

model LoginAttempt {
  id             String   @id @default(cuid())
  userId         String?
  identifierHash String
  ipHash         String?
  succeeded      Boolean
  attemptedAt    DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifierHash, attemptedAt])
  @@index([ipHash, attemptedAt])
  @@index([userId, attemptedAt])
}

model LoginRateLimitBucket {
  keyHash         String   @id
  windowStartedAt DateTime
  attemptCount    Int      @default(0)
  blockedUntil    DateTime?
  updatedAt       DateTime @updatedAt

  @@index([blockedUntil])
}

model AuditLog {
  id          String          @id @default(cuid())
  actorType   AuditActorType
  actorId     String?
  action      String
  resource    String
  resourceId  String?
  scopeType   String?
  scopeId     String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  occurredAt  DateTime        @default(now())
  actor       User?           @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, occurredAt])
  @@index([resource, resourceId, occurredAt])
  @@index([scopeType, scopeId, occurredAt])
  @@index([occurredAt])
}


enum MarketStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum StoreStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
}

enum SellerStaffStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum CatalogEntityStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductMediaType {
  IMAGE
  VIDEO
}

model Country {
  id               String   @id @default(cuid())
  iso2             String   @unique @db.Char(2)
  iso3             String?  @unique @db.Char(3)
  name             String
  nativeName       String?
  phoneCallingCode String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  markets          Market[]

  @@index([isActive, name])
}

model Currency {
  code          String           @id @db.Char(3)
  name          String
  symbol        String?
  minorUnit     Int              @default(2)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  defaultMarkets Market[]        @relation("MarketDefaultCurrency")
  marketLinks   MarketCurrency[]
  productPrices ProductPrice[]

  @@index([isActive, name])
}

model Market {
  id                  String          @id @default(cuid())
  code                String          @unique @db.VarChar(32)
  name                String
  countryId           String
  defaultCurrencyCode String          @db.Char(3)
  status              MarketStatus    @default(DRAFT)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  country             Country         @relation(fields: [countryId], references: [id], onDelete: Restrict)
  defaultCurrency     Currency        @relation("MarketDefaultCurrency", fields: [defaultCurrencyCode], references: [code], onDelete: Restrict)
  currencies          MarketCurrency[]
  storeLinks          StoreMarket[]
  productPrices       ProductPrice[]

  @@index([countryId, status])
  @@index([defaultCurrencyCode])
}

model MarketCurrency {
  marketId    String   @db.Text
  currencyCode String  @db.Char(3)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  market      Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  currency    Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  @@id([marketId, currencyCode])
  @@index([currencyCode, isEnabled])
}


model Seller {
  id          String       @id @default(cuid())
  ownerId     String       @unique
  status      SellerStatus @default(PENDING)
  legalName   String?
  displayName String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  stores      Store[]

  @@index([status, createdAt])
}

model Store {
  id        String      @id @default(cuid())
  sellerId  String
  slug      String      @unique @db.VarChar(160)
  name      String
  status    StoreStatus @default(DRAFT)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  seller    Seller      @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  markets   StoreMarket[]
  staff     SellerStaff[]
  products  Product[]

  @@index([sellerId, status])
  @@index([status, createdAt])
}

model StoreMarket {
  storeId   String
  marketId  String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@id([storeId, marketId])
  @@index([marketId, isEnabled])
}

model SellerStaff {
  id          String            @id @default(cuid())
  storeId     String
  userId      String
  invitedById String?
  status      SellerStaffStatus @default(INVITED)
  invitedAt   DateTime          @default(now())
  acceptedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user        User              @relation("SellerStaffUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy   User?             @relation("SellerStaffInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([storeId, userId])
  @@index([userId, status])
  @@index([storeId, status])
}


model Category {
  id          String              @id @default(cuid())
  parentId    String?
  slug        String              @unique @db.VarChar(180)
  name        String
  description String?
  imageUrl    String?
  status      CatalogEntityStatus @default(DRAFT)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  parent      Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]          @relation("CategoryTree")
  translations CategoryTranslation[]

  @@index([parentId, status, sortOrder])
  @@index([status, sortOrder])
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  locale      String   @db.VarChar(16)
  name        String
  description String?
  seoTitle    String?
  seoDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale, name])
}

model Brand {
  id          String              @id @default(cuid())
  slug        String              @unique @db.VarChar(180)
  name        String
  description String?
  logoUrl     String?
  websiteUrl  String?
  status      CatalogEntityStatus @default(DRAFT)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  translations BrandTranslation[]
  products     Product[]

  @@index([status, name])
}

model BrandTranslation {
  id          String   @id @default(cuid())
  brandId     String
  locale      String   @db.VarChar(16)
  name        String
  description String?
  seoTitle    String?
  seoDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, locale])
  @@index([locale, name])
}


model Product {
  id             String                @id @default(cuid())
  storeId        String
  brandId        String?
  slug           String                @db.VarChar(180)
  name           String
  description    String?
  status         CatalogEntityStatus   @default(DRAFT)
  approvalStatus ProductApprovalStatus @default(PENDING)
  approvedAt     DateTime?
  publishedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  store          Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  brand          Brand?                @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categories     ProductCategory[]
  translations   ProductTranslation[]
  media          ProductMedia[]
  variants       ProductVariant[]
  identifiers    ProductIdentifier[]

  @@unique([storeId, slug])
  @@index([storeId, status, approvalStatus, createdAt])
  @@index([brandId, status])
}

model ProductCategory {
  productId  String
  categoryId String
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId, productId])
}

model ProductTranslation {
  id          String   @id @default(cuid())
  productId   String
  locale      String   @db.VarChar(16)
  name        String
  description String?
  seoTitle    String?
  seoDescription String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale, name])
}

model ProductMedia {
  id         String          @id @default(cuid())
  productId  String
  type       ProductMediaType @default(IMAGE)
  url        String
  storageKey String?
  mimeType   String?
  altText    String?
  sortOrder  Int             @default(0)
  isPrimary  Boolean         @default(false)
  width      Int?
  height     Int?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  sku         String   @unique @db.VarChar(100)
  barcode     String?  @unique @db.VarChar(100)
  name        String?
  optionValues Json?
  weightGrams Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices      ProductPrice[]

  @@index([productId, isActive])
}

model ProductIdentifier {
  id             String   @id @default(cuid())
  productId      String
  identifierType String   @db.VarChar(32)
  value          String   @db.VarChar(128)
  createdAt      DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([identifierType, value])
  @@index([productId])
}

model ProductPrice {
  id               String         @id @default(cuid())
  variantId        String
  marketId         String
  currencyCode     String         @db.Char(3)
  amountMinor      BigInt
  compareAtMinor   BigInt?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  market           Market         @relation(fields: [marketId], references: [id], onDelete: Restrict)
  currency         Currency       @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  @@unique([variantId, marketId, currencyCode])
  @@index([marketId, currencyCode, amountMinor])
}

  updatedAt         DateTime       @updatedAt
  store             Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  user              User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  vendorOrder       VendorOrder    @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  media             ReviewMedia[]
  reports           ReviewReport[] @relation("StoreReviewReport")
  appeals           ReviewAppeal[] @relation("StoreReviewAppeal")

  @@unique([userId, storeId])
  @@index([storeId, status, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ReviewMedia {
  id              String         @id @default(cuid())
  productReviewId String?
  storeReviewId   String?
  url             String         @db.VarChar(2048)
  altText         String?        @db.VarChar(200)
  position        Int            @default(0)
  createdAt       DateTime       @default(now())
  productReview   ProductReview? @relation(fields: [productReviewId], references: [id], onDelete: Cascade)
  storeReview     StoreReview?   @relation(fields: [storeReviewId], references: [id], onDelete: Cascade)

  @@unique([productReviewId, url])
  @@unique([storeReviewId, url])
  @@index([productReviewId, position])
  @@index([storeReviewId, position])
}

model ReviewReport {
  id              String             @id @default(cuid())
  reporterId      String
  productReviewId String?
  storeReviewId   String?
  reason          ReviewReportReason
  details         String?            @db.VarChar(1000)
  status          ReviewReportStatus @default(PENDING)
  resolutionNote  String?            @db.VarChar(500)
  resolvedBy      String?
  resolvedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  reporter        User               @relation("ReviewReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  resolver        User?              @relation("ReviewReportResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)
  productReview   ProductReview?     @relation("ProductReviewReport", fields: [productReviewId], references: [id], onDelete: Cascade)
  storeReview     StoreReview?       @relation("StoreReviewReport", fields: [storeReviewId], references: [id], onDelete: Cascade)

  @@unique([reporterId, productReviewId])
  @@unique([reporterId, storeReviewId])
  @@index([status, createdAt])
  @@index([productReviewId, status])
  @@index([storeReviewId, status])
}

model ReviewAppeal {
  id              String             @id @default(cuid())
  authorId        String
  productReviewId String?
  storeReviewId   String?
  reason          String             @db.VarChar(2000)
  status          ReviewAppealStatus @default(PENDING)
  resolutionNote  String?            @db.VarChar(500)
  resolvedBy      String?
  resolvedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  author          User               @relation("ReviewAppealAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  resolver        User?              @relation("ReviewAppealResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)
  productReview   ProductReview?     @relation("ProductReviewAppeal", fields: [productReviewId], references: [id], onDelete: Cascade)
  storeReview     StoreReview?       @relation("StoreReviewAppeal", fields: [storeReviewId], references: [id], onDelete: Cascade)

  @@unique([productReviewId])
  @@unique([storeReviewId])
  @@index([status, createdAt])
}

model ProductQuestion {
  id          String                @id @default(cuid())
  productId   String
  userId      String
  question    String                @db.VarChar(2000)
  status      ProductQuestionStatus @default(PENDING)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  MARKETING_EMAIL
  NOTIFICATION_EMAIL
  COOKIES
}

enum AuditActorType {
  USER
  SYSTEM
  API
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  emailNormalized         String                   @unique
  passwordHash            String?
  displayName             String?
  status                  UserStatus               @default(PENDING)
  adminStatusReason       String?
  anonymizedAt            DateTime?
  emailVerifiedAt         DateTime?
  lastLoginAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  sessions                UserSession[]
  oauthAccounts           OAuthAccount[]
  twoFactor               UserTwoFactor?
  roleAssignments         UserRoleAssignment[]
  passwordResets          PasswordResetToken[]
  verificationTokens      VerificationToken[]
  consents                UserConsent[]
  loginAttempts           LoginAttempt[]
  auditEvents             AuditLog[]               @relation("AuditActor")
  platformPrivilegeTargets   PlatformPrivilegeRequest[] @relation("PlatformPrivilegeTarget")
  platformPrivilegeRequests  PlatformPrivilegeRequest[] @relation("PlatformPrivilegeRequester")
  platformPrivilegeReviews   PlatformPrivilegeRequest[] @relation("PlatformPrivilegeReviewer")
  sellerProfile           Seller?
  createdCommissionRules  CommissionRule[]          @relation("CommissionRuleCreator")
  createdAdCampaigns      AdCampaign[]               @relation("AdCampaignCreator")
  reviewedAdCampaigns     AdCampaign[]               @relation("AdCampaignReviewer")
  settledAdInvoices       AdInvoice[]                @relation("AdInvoiceSettler")
  storeMemberships        SellerStaff[]            @relation("SellerStaffUser")
  sentStoreInvitations    SellerStaff[]            @relation("SellerStaffInviter")
  carts                   Cart[]
  checkoutQuotes          CheckoutQuote[]
  addresses               UserAddress[]
  orders                  Order[]
  couponRedemptions       CouponRedemption[]
  returnRequests          ReturnRequest[]          @relation("ReturnRequestCustomer")
  reviewedReturnRequests  ReturnRequest[]          @relation("ReturnRequestReviewer")
  refundsRequested Refund[] @relation("RefundRequester")
  refundsCompleted Refund[] @relation("RefundCompleter")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  productReviews          ProductReview[]
  productQuestions        ProductQuestion[]
  productAnswers          ProductAnswer[]
  storeReviews            StoreReview[]
  submittedReviewReports  ReviewReport[]           @relation("ReviewReportReporter")
  resolvedReviewReports   ReviewReport[]           @relation("ReviewReportResolver")
  submittedReviewAppeals  ReviewAppeal[]           @relation("ReviewAppealAuthor")
  resolvedReviewAppeals   ReviewAppeal[]           @relation("ReviewAppealResolver")
  favorites               Favorite[]
  supportTickets          SupportTicket[]          @relation("SupportTicketCustomer")
  assignedSupportTickets  SupportTicket[]          @relation("SupportTicketAssignee")
  supportMessages         SupportMessage[]
  storeConversations      StoreConversation[]      @relation("ConversationCustomer")
  sentStoreMessages       StoreMessage[]           @relation("StoreMessageSender")
  reviewedReturnItems ReturnItem[] @relation("ReturnItemReviewer")
  supportAttachments    SupportAttachment[] @relation("SupportAttachmentUploader")
  storeMessageAttachments StoreMessageAttachment[] @relation("StoreMessageAttachmentUploader")
  notificationDeliveries NotificationDelivery[]
  productAnswerRevisions ProductAnswerRevision[]
  productQuestionReports ProductQuestionReport[] @relation("ProductQuestionReporter")
  moderatedProductQuestionReports ProductQuestionReport[] @relation("ProductQuestionReportModerator")
  @@index([status, createdAt])
  @@index([createdAt])
}

model Role {
  id          String               @id @default(cuid())
  key         String               @unique
  name        String
  description String?
  isSystem    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  permissions RolePermission[]
  assignments UserRoleAssignment[]
  staffMemberships SellerStaff[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRoleAssignment {
  id         String    @id @default(cuid())
  userId     String
  roleId     String
  // GLOBAL is the reserved unscoped assignment; scoped grants must provide both values.
  scopeType  String    @default("GLOBAL")
  scopeId    String    @default("GLOBAL")
  assignedAt DateTime  @default(now())
  expiresAt  DateTime?
  assignedBy String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([userId, expiresAt])
  @@index([roleId, scopeType, scopeId])
}

model UserSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  mfaVerifiedAt DateTime?
  stepUpVerifiedAt DateTime?
  stepUpExpiresAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model UserTwoFactor {
  id                 String                       @id @default(cuid())
  userId             String                       @unique
  secretCiphertext   String
  enabledAt          DateTime?
  lastVerifiedStep   BigInt?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  user               User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes      UserTwoFactorRecoveryCode[]

  @@index([enabledAt])
}

model UserTwoFactorRecoveryCode {
  id         String       @id @default(cuid())
  userId     String
  codeHash   String       @unique
  createdAt  DateTime     @default(now())
  usedAt     DateTime?
  twoFactor  UserTwoFactor @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, usedAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model VerificationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  purpose    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
}

model UserConsent {
  id         String      @id @default(cuid())
  userId     String
  type       ConsentType
  version    String
  granted    Boolean
  capturedAt DateTime    @default(now())
  source     String?
  ipAddress  String?
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, capturedAt])
}

model LoginAttempt {
  id             String   @id @default(cuid())
  userId         String?
  identifierHash String
  ipHash         String?
  succeeded      Boolean
  attemptedAt    DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifierHash, attemptedAt])
  @@index([ipHash, attemptedAt])
  @@index([userId, attemptedAt])
}

model LoginRateLimitBucket {
  keyHash         String    @id
  windowStartedAt DateTime
  attemptCount    Int       @default(0)
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
}

model AuditLog {
  id         String         @id @default(cuid())
  actorType  AuditActorType
  actorId    String?
  action     String
  resource   String
  resourceId String?
  scopeType  String?
  scopeId    String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  occurredAt DateTime       @default(now())
  actor      User?          @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, occurredAt])
  @@index([resource, resourceId, occurredAt])
  @@index([scopeType, scopeId, occurredAt])
  @@index([occurredAt])
}

enum MarketStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum SellerPayoutMethodType {
  IBAN
  LOCAL_BANK_ACCOUNT
}

enum SellerPayoutMethodStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  DISABLED
}

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum StoreStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
}

enum SellerStaffStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum CatalogEntityStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PropertyType {
  APARTMENT
  HOUSE
  LAND
  COMMERCIAL
}

enum PropertyListingType {
  SALE
  RENT
}

enum ProductMediaType {
  IMAGE
  VIDEO
}

enum AttributeValueType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
}

enum InventoryMovementType {
  RECEIPT
  RETURN_RECEIPT
  SALE
  ORDER_CANCELLATION
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
}

enum StockCountStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InventoryReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum StockTransferStatus {
  DRAFT
  SHIPPED
  RECEIVED
  CANCELLED
}

enum CartStatus {
  ACTIVE
  MERGED
  CHECKED_OUT
  ABANDONED
}

enum CheckoutQuoteStatus {
  ACTIVE
  EXPIRED
  RELEASED
  CONVERTED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  INITIATING
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

enum RefundStatus {
  PENDING_MANUAL
  PROCESSING_PROVIDER
  PROVIDER_FAILED
  COMPLETED
}

enum VendorOrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShipmentTrackingStatus {
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
}

enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  CANCELLED
}

enum ReturnItemStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
}

enum ReviewReportReason {
  INAPPROPRIATE
  SPAM
  FAKE
  CONFLICT_OF_INTEREST
  PERSONAL_INFORMATION
  OTHER
}

enum ReviewReportStatus {
  PENDING
  DISMISSED
  ACTIONED
}

enum ReviewAppealStatus {
  PENDING
  UPHELD
  RESTORED
}

enum ProductQuestionStatus {
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
}

enum ProductAnswerStatus {
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
}

enum ProductQuestionReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model Country {
  id               String        @id @default(cuid())
  iso2             String        @unique @db.Char(2)
  iso3             String?       @unique @db.Char(3)
  name             String
  nativeName       String?
  phoneCallingCode String?
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  markets          Market[]
  userAddresses    UserAddress[]

  @@index([isActive, name])
}

model Currency {
  code           String           @id @db.Char(3)
  name           String
  symbol         String?
  minorUnit      Int              @default(2)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  defaultMarkets Market[]         @relation("MarketDefaultCurrency")
  marketLinks    MarketCurrency[]
  productPrices  ProductPrice[]
  carts          Cart[]
  checkoutQuotes CheckoutQuote[]
  orders         Order[]
  payments       Payment[]
  refunds        Refund[]
  commissionTransactions CommissionTransaction[]
  coupons        Coupon[]         @relation("CouponCurrency")
  adCampaigns    AdCampaign[]
  adInvoices     AdInvoice[]
  adSpendLedgerEntries AdSpendLedgerEntry[]
  ledgerAccounts LedgerAccount[]
  journalEntries JournalEntry[]
  sellerPayoutMethods SellerPayoutMethod[]

  shippingRates StoreShippingRate[]

  @@index([isActive, name])
}

model Market {
  id                  String              @id @default(cuid())
  code                String              @unique @db.VarChar(32)
  name                String
  countryId           String
  defaultCurrencyCode String              @db.Char(3)
  status              MarketStatus        @default(DRAFT)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  country             Country             @relation(fields: [countryId], references: [id], onDelete: Restrict)
  defaultCurrency     Currency            @relation("MarketDefaultCurrency", fields: [defaultCurrencyCode], references: [code], onDelete: Restrict)
  currencies          MarketCurrency[]
  storeLinks          StoreMarket[]
  productPrices       ProductPrice[]
  carts               Cart[]
  checkoutQuotes      CheckoutQuote[]
  orders              Order[]
  shippingRates       StoreShippingRate[]
  taxRates            MarketTaxRate[]
  adCampaigns         AdCampaign[]

  @@index([countryId, status])
  @@index([defaultCurrencyCode])
}

model MarketCurrency {
  marketId     String   @db.Text
  currencyCode String   @db.Char(3)
  isEnabled    Boolean  @default(true)
  createdAt    DateTime @default(now())
  market       Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  currency     Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  @@id([marketId, currencyCode])
  @@index([currencyCode, isEnabled])
}

model Seller {
  id          String       @id @default(cuid())
  ownerId     String       @unique
  status      SellerStatus @default(PENDING)
  legalName   String?
  displayName String?
  contactName String?
  contactEmail String?
  phoneNumber String?
  residence String?
  businessType String?
  sellingCategories String?
  intendedProducts String? @db.Text
  description String? @db.Text
  facebookUrl String?
  youtubeUrl String?
  twitterUrl String?
  identityDocumentFileId String?
  registrationCountryCode String? @db.Char(2)
  registrationNumber String? @db.VarChar(120)
  registrationAuthority String? @db.VarChar(160)
  registrationDate DateTime?
  registeredAddress String? @db.VarChar(500)
  taxIdentificationNumber String? @db.VarChar(120)
  businessWebsite String? @db.VarChar(2048)
  businessRegistrationDocumentFileId String?
  taxCertificateDocumentFileId String?
  proofOfAddressDocumentFileId String?
  latitude Float?
  longitude Float?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  store       Store?
  commissionRules CommissionRule[]
  commissionTransactions CommissionTransaction[]
  payoutMethods SellerPayoutMethod[]

  @@index([status, createdAt])
}

model SellerPayoutMethod {
  id                   String                   @id @default(cuid())
  sellerId             String
  type                 SellerPayoutMethodType
  accountHolderName    String                   @db.VarChar(160)
  bankName             String                   @db.VarChar(160)
  countryCode          String                   @db.VarChar(2)
  currencyCode         String                   @db.Char(3)
  encryptedDetails     String                   @db.Text
  encryptionKeyVersion Int
  accountLast4         String                   @db.VarChar(4)
  fingerprint          String                   @db.VarChar(64)
  submissionVersion    Int                      @default(1)
  submittedAt          DateTime                 @default(now())
  status               SellerPayoutMethodStatus @default(PENDING_VERIFICATION)
  isDefault            Boolean                  @default(false)
  verifiedAt           DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  seller               Seller                   @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  currency             Currency                 @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  @@unique([sellerId, currencyCode, fingerprint])
  @@index([sellerId, currencyCode, status, isDefault])
  @@index([status, submittedAt])
}

model Store {
  id                         String                      @id @default(cuid())
  storeNumber                BigInt                      @unique @default(autoincrement())
  sellerId                   String
  slug                       String                      @unique @db.VarChar(160)
  name                       String
  description                String?                     @db.VarChar(2000)
  publicPhone                String?                     @db.VarChar(25)
  publicAddress              String?                     @db.VarChar(500)
  logoUrl                    String?                     @db.VarChar(2048)
  bannerUrl                  String?                     @db.VarChar(2048)
  logoStorageKey              String?                     @db.VarChar(512)
  bannerStorageKey            String?                     @db.VarChar(512)
  shippingPolicy             String?                     @db.Text
  returnsPolicy              String?                     @db.Text
  privacyPolicy              String?                     @db.Text
  termsOfSale                String?                     @db.Text
  status                     StoreStatus                 @default(DRAFT)
  shippingContactName        String?                     @db.VarChar(120)
  shippingPhone              String?                     @db.VarChar(25)
  shippingAddressLine1       String?                     @db.VarChar(240)
  shippingAddressLine2       String?                     @db.VarChar(240)
  shippingCity               String?                     @db.VarChar(120)
  shippingRegion             String?                     @db.VarChar(120)
  shippingPostalCode         String?                     @db.VarChar(40)
  shippingCountryCode        String?                     @db.VarChar(2)
  shippingInstructions       String?                     @db.VarChar(1000)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  seller                     Seller                      @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  markets                    StoreMarket[]
  staff                      SellerStaff[]
  mediaAssets                StoreMediaAsset[]
  products                   Product[]
  reviews                    StoreReview[]
  warehouses                 Warehouse[]
  stockTransfers             StockTransfer[]
  stockCountSessions         StockCountSession[]
  shippingRates              StoreShippingRate[]
  checkoutShippingSelections CheckoutShippingSelection[]
  checkoutQuoteLines         CheckoutQuoteLine[]
  vendorOrders               VendorOrder[]
  conversations              StoreConversation[]
  commissionTransactions     CommissionTransaction[]
  adCampaigns                 AdCampaign[]
  adInvoices                  AdInvoice[]
  adSpendLedgerEntries        AdSpendLedgerEntry[]

  @@unique([sellerId])
  @@index([sellerId, status])
  @@index([status, createdAt])
}


model StoreMediaAsset {
  id         String   @id @default(cuid())
  storeId    String
  url        String   @db.VarChar(2048)
  storageKey String?  @unique @db.VarChar(512)
  mimeType   String?  @db.VarChar(100)
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
}

model StoreMarket {
  storeId   String
  marketId  String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@id([storeId, marketId])
  @@index([marketId, isEnabled])
}

model SellerStaff {
  id          String            @id @default(cuid())
  storeId     String
  userId      String
  roleId      String?
  invitedById String?
  status      SellerStaffStatus @default(INVITED)
  invitedAt   DateTime          @default(now())
  expiresAt   DateTime?
  acceptedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user        User              @relation("SellerStaffUser", fields: [userId], references: [id], onDelete: Cascade)
  role        Role?             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy   User?             @relation("SellerStaffInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([storeId, userId])
  @@index([userId, status])
  @@index([storeId, status])
  @@index([roleId])
}

model Category {
  id           String                @id @default(cuid())
  parentId     String?
  slug         String                @unique @db.VarChar(180)
  name         String
  description  String?
  imageUrl     String?
  status       CatalogEntityStatus   @default(DRAFT)
  sortOrder    Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]            @relation("CategoryTree")
  translations CategoryTranslation[]
  productLinks ProductCategory[]
  commissionRules CommissionRule[]
  orderItems   OrderItem[]
  adCampaigns  AdCampaign[]
  attributeLinks CategoryAttribute[]

  @@index([parentId, status, sortOrder])
  @@index([status, sortOrder])
}

model CategoryTranslation {
  id             String   @id @default(cuid())
  categoryId     String
  locale         String   @db.VarChar(16)
  name           String
  description    String?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale, name])
}

model Brand {
  id           String              @id @default(cuid())
  slug         String              @unique @db.VarChar(180)
  name         String
  description  String?
  logoUrl      String?
  websiteUrl   String?
  status       CatalogEntityStatus @default(DRAFT)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  translations BrandTranslation[]
  products     Product[]
  adCampaigns  AdCampaign[]

  @@index([status, name])
}

model BrandTranslation {
  id             String   @id @default(cuid())
  brandId        String
  locale         String   @db.VarChar(16)
  name           String
  description    String?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  brand          Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, locale])
  @@index([locale, name])
}

model Product {
  id                  String                @id @default(cuid())
  productNumber       BigInt                @unique @default(autoincrement())
  storeId             String
  brandId             String?
  slug                String                @db.VarChar(180)
  name                String
  description         String?
  specifications      Json?
  city                String?               @db.VarChar(120)
  district            String?               @db.VarChar(120)
  streetAddress       String?               @db.VarChar(500)
  contactPhone        String?               @db.VarChar(40)
  videoUrl            String?               @db.VarChar(2048)
  status              CatalogEntityStatus   @default(DRAFT)
  approvalStatus      ProductApprovalStatus @default(PENDING)
  rejectionReason     String?
  approvedAt          DateTime?
  publishedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  store               Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  brand               Brand?                @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categories          ProductCategory[]
  translations        ProductTranslation[]
  media               ProductMedia[]
  propertyDetails     ProductPropertyDetails?
  variants            ProductVariant[]
  identifiers         ProductIdentifier[]
  attributes          ProductAttribute[]
  localityId          String?
  neighborhood        String?               @db.VarChar(120)

  resourceId       String?   @db.VarChar(128)
  deduplicationKey String    @unique @db.VarChar(180)
  readAt           DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries        NotificationDelivery[]

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MessageAttachmentStatus {
  PENDING_SCAN
  CLEAN
  REJECTED
}

model SupportTicket {
  id              String                @id @default(cuid())
  ticketNumber    String                @unique @db.VarChar(24)
  customerId      String
  assignedToId    String?
  subject         String                @db.VarChar(180)
  category        String                @db.VarChar(32)
  status          SupportTicketStatus   @default(OPEN)
  priority        SupportTicketPriority @default(NORMAL)
  lastMessageAt   DateTime              @default(now())
  resolvedAt      DateTime?
  closedAt        DateTime?
  customerReadAt  DateTime?
  agentReadAt     DateTime?
  firstResponseAt DateTime?
  firstResponseDueAt DateTime?
  resolutionDueAt DateTime?
  firstResponseBreachedAt DateTime?
  resolutionBreachedAt DateTime?
  escalatedAt DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  customer        User                  @relation("SupportTicketCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  assignedTo      User?                 @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages        SupportMessage[]
  attachments    SupportAttachment[]

  @@index([customerId, updatedAt])
  @@index([status, priority, lastMessageAt])
  @@index([assignedToId, status, lastMessageAt])
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  senderId   String
  body       String        @db.VarChar(8000)
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender     User          @relation(fields: [senderId], references: [id], onDelete: Restrict)
  attachments SupportAttachment[]

  @@index([ticketId, isInternal, createdAt])
  @@index([senderId, createdAt])
}

model SupportAttachment {
  id           String                  @id @default(cuid())
  ticketId     String
  messageId    String?
  uploadedById String
  objectKey    String                  @unique @db.VarChar(512)
  fileName     String                  @db.VarChar(255)
  contentType  String                  @db.VarChar(120)
  sizeBytes    Int
  status       MessageAttachmentStatus @default(PENDING_SCAN)
  scanError    String?                 @db.VarChar(500)
  createdAt    DateTime                @default(now())
  scannedAt    DateTime?
  ticket       SupportTicket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message      SupportMessage?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploadedBy   User                    @relation("SupportAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([ticketId, status, createdAt])
  @@index([messageId])
}

model SupportSlaPolicy {
  priority             SupportTicketPriority @id
  firstResponseMinutes Int
  resolutionMinutes    Int
  enabled              Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}


model StoreConversation {
  id             String         @id @default(cuid())
  customerId     String
  storeId        String
  orderId        String?
  subject        String         @db.VarChar(180)
  lastMessageAt  DateTime       @default(now())
  customerReadAt DateTime?
  storeReadAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  customer       User           @relation("ConversationCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order          Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages       StoreMessage[]
  attachments    StoreMessageAttachment[]

  @@index([customerId, updatedAt])
  @@index([storeId, lastMessageAt])
  @@index([orderId])
}

model StoreMessage {
  id             String            @id @default(cuid())
  conversationId String
  senderId       String
  body           String            @db.VarChar(8000)
  createdAt      DateTime          @default(now())
  conversation   StoreConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User              @relation("StoreMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  attachments    StoreMessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model StoreMessageAttachment {
  id             String                  @id @default(cuid())
  conversationId String
  messageId      String?
  uploadedById   String
  objectKey      String                  @unique @db.VarChar(512)
  fileName       String                  @db.VarChar(255)
  contentType    String                  @db.VarChar(120)
  sizeBytes      Int
  status         MessageAttachmentStatus @default(PENDING_SCAN)
  scanError      String?                 @db.VarChar(500)
  createdAt      DateTime                @default(now())
  scannedAt      DateTime?
  conversation   StoreConversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        StoreMessage?           @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploadedBy     User                    @relation("StoreMessageAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([conversationId, status, createdAt])
  @@index([messageId])
}

enum PaymentProviderEnvironment {
  TEST
  LIVE
}

enum PaymentProviderConfigStatus {
  DRAFT
  CONFIGURED
  ACTIVE
  DISABLED
  ARCHIVED
}

model PaymentProviderConfig {
  id                       String                       @id @default(cuid())
  providerKey              String                       @db.VarChar(64)
  displayName              String                       @db.VarChar(120)
  environment              PaymentProviderEnvironment
  status                   PaymentProviderConfigStatus @default(DRAFT)
  encryptedCredentials    String?                      @db.Text
  credentialsKeyVersion   Int                          @default(1)
  credentialFingerprint   String?                      @db.VarChar(24)
  supportedCountries      String[]                     @default([])
  supportedCurrencies     String[]                     @default([])
  enabledPaymentMethods   String[]                     @default([])
  sortOrder               Int                          @default(0)
  lastVerifiedAt          DateTime?
  lastVerificationStatus  String?                      @db.VarChar(32)
  lastVerificationMessage String?                      @db.VarChar(300)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  archivedAt              DateTime?
  payments                Payment[]

  @@unique([providerKey, environment])
  @@index([status, sortOrder])
  @@index([environment, status])
}

model Payment {
  id                  String                @id @default(cuid())
  orderId             String
  provider            String                @db.VarChar(64)
  providerConfigId    String?
  providerEnvironment PaymentProviderEnvironment?
  encryptedProviderCredentials String?      @db.Text
  providerCredentialsKeyVersion Int?
  providerConfig      PaymentProviderConfig? @relation(fields: [providerConfigId], references: [id], onDelete: Restrict)
  status              PaymentStatus         @default(INITIATING)
  amountMinor         BigInt
  currencyCode        String                @db.Char(3)
  idempotencyKey      String                @unique @db.VarChar(180)
  providerReference   String?               @db.VarChar(180)
  checkoutUrl         String?               @db.VarChar(2000)
  expiresAt           DateTime?
  failureCode         String?               @db.VarChar(120)
  failureMessage      String?               @db.VarChar(500)
  succeededAt         DateTime?
  lastProviderEventAt DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  order               Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  currency            Currency              @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  events              PaymentWebhookEvent[]
  refunds             Refund[]

  @@unique([provider, providerReference])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@index([providerConfigId, createdAt])
}

model LedgerAccount {
  id           String            @id @default(cuid())
  code         String            @db.VarChar(64)
  name         String            @db.VarChar(160)
  accountType  LedgerAccountType
  scopeType    String            @default("GLOBAL") @db.VarChar(32)
  scopeId      String            @default("GLOBAL") @db.VarChar(128)
  currencyCode String            @db.Char(3)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  currency     Currency          @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  lines        JournalLine[]

  @@unique([scopeType, scopeId, code, currencyCode])
  @@index([currencyCode, accountType, scopeType, scopeId])
  @@index([isActive, code])
}

model JournalEntry {
  id             String        @id @default(cuid())
  idempotencyKey String        @unique @db.VarChar(180)
  sourceType     String        @db.VarChar(64)
  sourceId       String        @db.VarChar(180)
  currencyCode   String        @db.Char(3)
  description    String        @db.VarChar(500)
  occurredAt     DateTime
  postedAt       DateTime      @default(now())
  reversalOfId   String?       @unique
  createdAt      DateTime      @default(now())
  currency       Currency      @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  lines          JournalLine[]
  reversalOf     JournalEntry? @relation("JournalEntryReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal       JournalEntry? @relation("JournalEntryReversal")

  @@index([sourceType, sourceId])
  @@index([currencyCode, postedAt, id])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  accountId      String
  lineNumber     Int
  debitMinor     BigInt       @default(0)
  creditMinor    BigInt       @default(0)
  memo           String?      @db.VarChar(500)
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  account        LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([journalEntryId, lineNumber])
  @@index([accountId, journalEntryId])
}

model CommissionRule {
  id              String   @id @default(cuid())
  sellerId        String?
  categoryId      String?
  rateBasisPoints Int
  effectiveFrom   DateTime
  effectiveUntil  DateTime?
  isActive        Boolean  @default(true)
  deactivatedAt   DateTime?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  seller          Seller?  @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy       User?    @relation("CommissionRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  transactions    CommissionTransaction[]

  @@index([sellerId, categoryId, isActive, effectiveFrom])
  @@index([categoryId, isActive, effectiveFrom])
  @@index([isActive, effectiveFrom])
}

model CommissionTransaction {
  id                String   @id @default(cuid())
  orderId           String
  vendorOrderId     String
  orderItemId       String   @unique
  storeId           String
  sellerId          String
  commissionRuleId  String?
  categoryId        String?
  categoryName      String?
  ruleScopeType     String   @db.VarChar(32)
  rateBasisPoints   Int
  baseAmountMinor   BigInt
  commissionMinor   BigInt
  currencyCode      String   @db.Char(3)
  createdAt         DateTime @default(now())
  order             Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendorOrder       VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  orderItem         OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  store             Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  seller            Seller    @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  commissionRule    CommissionRule? @relation(fields: [commissionRuleId], references: [id], onDelete: Restrict)
  currency          Currency  @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  @@index([orderId])
  @@index([vendorOrderId])
  @@index([storeId, createdAt])
  @@index([sellerId, createdAt])
  @@index([commissionRuleId])
}

model Refund {
  id                String       @id @default(cuid())
  orderId           String
  paymentId         String
  returnRequestId   String       @unique
  currencyCode      String       @db.Char(3)
  status            RefundStatus @default(PENDING_MANUAL)
  amountMinor       BigInt
  idempotencyKey    String       @unique @db.VarChar(180)
  externalReference String?      @unique @db.VarChar(180)
  note              String?      @db.VarChar(1000)
  requestedById     String
  completedById     String?
  requestedAt       DateTime     @default(now())
  completedAt       DateTime?
  providerSubmittedAt DateTime?  
  providerAttempt     Int          @default(1)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  returnRequest     ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  currency          Currency     @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  requestedBy       User         @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  completedBy       User?        @relation("RefundCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  items             RefundItem[]

  @@index([paymentId, status, createdAt])
  @@index([status, requestedAt])
}

model RefundItem {
  id           String      @id @default(cuid())
  refundId     String
  returnItemId String      @unique
  quantity     Int
  amountMinor  BigInt
  createdAt    DateTime    @default(now())
  refund       Refund      @relation(fields: [refundId], references: [id], onDelete: Cascade)
  returnItem   ReturnItem  @relation(fields: [returnItemId], references: [id], onDelete: Restrict)

  @@index([refundId])
}

model PaymentWebhookEvent {
  id              String    @id @default(cuid())
  provider        String    @db.VarChar(64)
  providerEventId String    @db.VarChar(200)
  eventType       String    @db.VarChar(120)
  paymentId       String?
  payloadHash     String    @db.Char(64)
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  processingError String?   @db.VarChar(500)
  payment         Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([paymentId, receivedAt])
  @@index([processedAt, receivedAt])
}
model PlatformPrivilegeRequest {
  id             String                         @id @default(cuid())
  targetUserId   String
  requestedById  String
  reviewedById   String?
  status         PlatformPrivilegeRequestStatus @default(PENDING)
  reason         String                         @db.VarChar(1000)
  decisionNote   String?                        @db.VarChar(1000)
  requestedAt    DateTime                       @default(now())
  reviewedAt     DateTime?
  targetUser     User                           @relation("PlatformPrivilegeTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  requester      User                           @relation("PlatformPrivilegeRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewer       User?                          @relation("PlatformPrivilegeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, requestedAt])
  @@index([targetUserId, status])
  @@index([requestedById, requestedAt])
  @@index([reviewedById, reviewedAt])
}

enum PlatformPrivilegeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model AiAssistantSetting {
  id                  String   @id @default("global")
  enabled             Boolean  @default(false)
  model               String   @default("openai/gpt-oss-20b") @db.VarChar(120)
  maxCompletionTokens Int      @default(900)
  updatedAt           DateTime @updatedAt
}


enum AdCampaignStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AdCampaignEventType {
  IMPRESSION
  CLICK
}

enum AdInvoiceStatus {
  OPEN
  SETTLED
  VOID
}

model AdCampaign {
  id String @id @default(cuid())
  storeId String
  productId String
  createdById String
  reviewedById String?
  marketId String?
  currencyCode String? @db.Char(3)
  targetCategoryId String?
  targetBrandId String?
  targetKeywords String[] @default([])
  budgetMinor BigInt
  dailyBudgetMinor BigInt
  cpcBidMinor BigInt
  spentMinor BigInt @default(0)
  impressionCount BigInt @default(0)
  clickCount BigInt @default(0)
  title String @db.VarChar(140)
  message String? @db.VarChar(300)
  status AdCampaignStatus @default(DRAFT)
  moderationNote String? @db.VarChar(500)
  startsAt DateTime
  endsAt DateTime
  submittedAt DateTime?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  market Market? @relation(fields: [marketId], references: [id], onDelete: Restrict)
  currency Currency? @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  targetCategory Category? @relation(fields: [targetCategoryId], references: [id], onDelete: SetNull)
  targetBrand Brand? @relation(fields: [targetBrandId], references: [id], onDelete: SetNull)
  createdBy User @relation("AdCampaignCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("AdCampaignReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  events AdCampaignEvent[]
  spendEntries AdSpendLedgerEntry[]
  @@index([storeId, status, createdAt])
  @@index([status, submittedAt])
  @@index([productId, status])
  @@index([startsAt, endsAt, status])
  @@index([marketId, status, startsAt, endsAt])
  @@index([targetCategoryId, targetBrandId, status])
}

model AdCampaignEvent {
  id String @id @default(cuid())
  campaignId String
  eventId String @db.VarChar(80)
  type AdCampaignEventType
  visitorHash String? @db.Char(64)
  costMinor BigInt @default(0)
  occurredAt DateTime @default(now())
  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  spendEntry AdSpendLedgerEntry?
  @@unique([campaignId, eventId])
  @@index([campaignId, type, occurredAt])
}

model AdSpendLedgerEntry {
  id String @id @default(cuid())
  campaignId String
  eventId String @unique
  storeId String
  currencyCode String @db.Char(3)
  amountMinor BigInt
  createdAt DateTime @default(now())
  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  event AdCampaignEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  currency Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  @@index([storeId, currencyCode, createdAt])
  @@index([campaignId, createdAt])
}

model AdInvoice {
  id String @id @default(cuid())
  storeId String
  currencyCode String @db.Char(3)
  periodStart DateTime
  periodEnd DateTime
  amountMinor BigInt
  status AdInvoiceStatus @default(OPEN)
  paymentReference String? @db.VarChar(180)
  settledAt DateTime?
  settledById String?
  dueAt DateTime
  createdAt DateTime @default(now())
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  currency Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  settledBy User? @relation("AdInvoiceSettler", fields: [settledById], references: [id], onDelete: SetNull)
  @@unique([storeId, currencyCode, periodStart])
  @@index([status, dueAt])
}


model CategoryAttribute {
  id                    String              @id @default(cuid())
  categoryId            String
  attributeDefinitionId String
  sortOrder             Int                 @default(0)
  isRequired            Boolean             @default(false)
  isVariantLevel        Boolean             @default(false)
